{
  "name": "edison",
  "title": "Intel Edison",
  "description": "The Intel Edison (Kit for Arduino) running open-edison's edison-image (Debian 13). Sketches are compiled on your computer by Zig and uploaded over SSH, by USB or the network.",
  "homepage": "https://github.com/open-edison/platform-edison",
  "license": "MIT",
  "keywords": ["dev-platform", "intel", "edison", "x86_64", "linux"],
  "engines": {
    "platformio": "^6"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/open-edison/platform-edison.git"
  },
  "version": "0.1.8",
  "frameworks": {
    "arduino": {
      "package": "framework-arduino-edison",
      "script": "builder/frameworks/arduino.py"
    }
  },
  "packages": {
    "framework-arduino-edison": {
      "type": "framework",
      "optional": true,
      "version": "edison-core"
    },
    "tool-edison-sysroot": {
      "type": "framework",
      "optional": true,
      "version": "edison-sysroot"
    },
    "toolchain-zig": {
      "type": "toolchain",
      "version": "edison-zig"
    },
    "tool-edison": {
      "type": "uploader",
      "optional": true,
      "version": "edison-tools"
    }
  }
}
